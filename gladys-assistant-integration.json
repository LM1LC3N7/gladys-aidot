    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Reading interval (seconds)",
        "fr": "Intervalle de lecture (secondes)"
      },
      "description": {
        "en": "How often each light is read on the network (30 to 3600 s); the changes it pushes are shown at once between two reads.",
        "fr": "Fréquence de lecture de chaque lumière sur le réseau (30 à 3600 s) ; les changements qu’elle envoie s’affichent aussitôt entre deux lectures."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
